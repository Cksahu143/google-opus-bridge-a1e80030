# Supabase
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth / Nexus
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_AI_API_KEY=
GOOGLE_CLOUD_PROJECT=

# GitHub integration
GITHUB_TOKEN=

# Legacy NotebookLM REST bridge (optional; server-side Edge Function secrets)
NOTEBOOKLM_BASE_URL=
NOTEBOOKLM_SERVER_TOKEN=

# Browser gateway providers (server-side Supabase Edge Function secrets)
# Never put these in VITE_* variables or browser code.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_BROWSER_TOKEN=
STEEL_API_KEY=
STEEL_PROFILE_ID=
BROWSERBASE_API_KEY=
BROWSERLESS_API_TOKEN=
BROWSERLESS_BASE_URL=https://production-sfo.browserless.io
# Optional: use a saved Browserless authenticated profile.
BROWSERLESS_PROFILE=
# Default is 24h; choose a lower value if your Browserless plan requires it.
BROWSERLESS_SESSION_TTL_MS=86400000

# Optional external integrations
REPLICATE_API_TOKEN=
HUGGINGFACE_API_TOKEN=
DAYTONA_API_KEY=
