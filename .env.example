# Supabase
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only elevated key. Prefer SUPABASE_SECRET_KEY when your project has the new key model.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel NotebookLM iPad login bridge
# Normal setup does NOT require a manually generated NOTEBOOKLM_MASTER_TOKEN_JSON.
# The app creates the master-token credential after the iPad login and stores it in Supabase Vault.
# Legacy fallback only:
NOTEBOOKLM_MASTER_TOKEN_JSON=

# Browserless is required for the no-command iPad bootstrap.
# Keep this server-side; never use a VITE_* name.
BROWSERLESS_API_TOKEN=
BROWSERLESS_BASE_URL=https://production-sfo.browserless.io

# Google OAuth / Nexus
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_AI_API_KEY=
GOOGLE_CLOUD_PROJECT=

# GitHub integration
GITHUB_TOKEN=

# Legacy NotebookLM REST bridge (optional; server-side Edge Function secrets)
NOTEBOOKLM_BASE_URL=
NOTEBOOKLM_SERVER_TOKEN=

# Optional browser gateway providers (server-side Supabase Edge Function secrets)
# These are for remote-browser testing, not for the iPad master-token bootstrap.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_BROWSER_TOKEN=
STEEL_API_KEY=
STEEL_PROFILE_ID=
BROWSERBASE_API_KEY=
BROWSERLESS_PROFILE=
BROWSERLESS_SESSION_TTL_MS=86400000

# Optional external integrations
REPLICATE_API_TOKEN=
HUGGINGFACE_API_TOKEN=
DAYTONA_API_KEY=
